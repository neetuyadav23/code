# First Negative in Windows of Size K -- https://www.geeksforgeeks.org/problems/first-negative-integer-in-every-window-of-size-k3345/1
# 2 approaches used -- first know the brute see the repetition and recongnize why and where optimization works
# Time Complexity: O(n)
# Space Complexity: O(n)

from collections import deque
class Solution:
    def firstNegInt(self, arr, k): 
        
        
         '''q=deque()
         i,j=0,0
         neg=[]
         
         while j < len(arr):
             size=(j-i)+1
             
                 
             if size < k:
                 if arr[j] < 0:
                     q.append(arr[j])
                 j+=1
                 
             if size == k:
                 if arr[j] < 0:
                     q.append(arr[j])
                 if len(q)==0:
                     q.append(0)
                 neg.append(q[0])
                 if q[0]==arr[i] or q[0]==0:
                     q.popleft()
                 i+=1
                 j+=1
         return neg'''
         
         # M2 -- storing only indices, instead of values
         # To correctly handle cases where the same negative value appears
         # multiple times, example--> -2,-2
         
         q=deque()
         i,j=0,0
         neg=[]
         
         while j < len(arr):
             size=(j-i)+1
             
                 
             if size < k:
                 if arr[j] < 0:
                     q.append(j)
                 j+=1
                 
             if size == k:
                 if arr[j] < 0:
                     q.append(j)
                 if len(q)==0:
                     neg.append(0)
                 else:
                     neg.append(arr[q[0]])
                     
                 if q and q[0]==i :
                     q.popleft()
                 i+=1
                 j+=1
         return neg
                 
