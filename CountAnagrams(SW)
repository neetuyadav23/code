class Solution:
    def search(self,pat, txt):
        i,j,cnt=0,0,0
        size=len(pat)
        char=""
        
        sorted_pat="".join(sorted(pat))

        while j < len(txt):
            char+=txt[j]
            wsize=(j=i)+1
            
            if wsize < size:
                j+=1
                
            else:
                sorted_char="".join(sorted(char))
                if sorted_pat == sorted_char:
                    cnt+=1
        
