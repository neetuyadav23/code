		        # now this (k log k) is for one window, so for total windows

		        # total windows = j-1+1= O(n)

		        # Therefore, total here = O(n × k log k)
		        if sort_txt == sort_pat:
		            cnt+=1

		        char=char[1:] # costs O(k)
		        # for n windows total costs= O(nk)
		        i+=1
		        j+=1
		return cnt
