		# THEREFORE, SPACE COMPLEXITY = o(k)

		s_pat=sorted(pat) # sorted take O(m log m)
		sort_pat="".join(s_pat) # takes O(m)
		k=len(pat)

		# so till here TC = O(m log m) -- bigger one takes over

		i,j=0,0
		char=""
		cnt=0

		while j < len(txt):
		    # let len(txt)= n so this loop runs O(n)

		    char+=txt[j] # this line has hidden cost because strings are immutable
		    # this can take O(k) but as sorting complexity is greater it dominates
		    # so--  k log k > k
		    size=(j-i)+1

		    if size < k:
		        j+=1

		    if size == k:
		        # Now char will have legth k
		        sort_txt="".join(sorted(char))

